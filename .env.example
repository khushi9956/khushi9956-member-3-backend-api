PORT=5000
NODE_ENV=development

# MongoDB connection. If MongoDB is not running, the server falls back to an
# in-memory demo database in development (data is lost on restart).
MONGO_URI=mongodb://127.0.0.1:27017/saas_collab_db

# Use a long random string here. Never commit your real .env file.
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend addresses allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Set to false to stop the server instead of using the in-memory demo database
ALLOW_MEMORY_DB=true
